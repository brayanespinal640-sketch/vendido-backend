generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoEntrega {
  DELIVERY
  PRESENCIAL
  AMBOS
}

enum EstadoProducto {
  DISPONIBLE
  VENDIDO
}

enum EstadoEnvio {
  ACORDADO_PRESENCIAL
  PENDIENTE_DE_ENVIO
  EN_TRANSPORTE
  ENTREGADO
}

model User {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  password_hash String
  foto_perfil   String?
  telefono      String?
  descripcion   String?
  tipo_usuario  String   @default("cliente")
  created_at    DateTime @default(now())

  products                 Product[]
  conversationsAsComprador Conversation[] @relation("CompradorConversations")
  conversationsAsVendedor  Conversation[] @relation("VendedorConversations")
  messages                 Message[]      @relation("EmisorMessages")
  ordersAsComprador        Order[]        @relation("CompradorOrders")
  ordersAsVendedor         Order[]        @relation("VendedorOrders")

  @@map("users")
}

model Product {
  id           String         @id @default(uuid())
  user_id      String
  titulo       String
  descripcion  String
  precio       Float
  imagenes     String[]
  tipo_entrega TipoEntrega    @default(AMBOS)
  estado       EstadoProducto @default(DISPONIBLE)
  created_at   DateTime       @default(now())

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@map("products")
}

model Conversation {
  id           String   @id @default(uuid())
  comprador_id String
  vendedor_id  String
  producto_id  String
  created_at   DateTime @default(now())

  comprador User      @relation("CompradorConversations", fields: [comprador_id], references: [id], onDelete: Cascade)
  vendedor  User      @relation("VendedorConversations", fields: [vendedor_id], references: [id], onDelete: Cascade)
  producto  Product   @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([comprador_id, vendedor_id, producto_id])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  emisor_id       String
  contenido       String
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  emisor       User         @relation("EmisorMessages", fields: [emisor_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Order {
  id           String      @id @default(uuid())
  producto_id  String
  comprador_id String
  vendedor_id  String
  metodo_envio TipoEntrega
  estado_envio EstadoEnvio
  monto_total  Float
  direccion    String?
  created_at   DateTime    @default(now())

  producto Product @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  comprador User   @relation("CompradorOrders", fields: [comprador_id], references: [id], onDelete: Cascade)
  vendedor  User   @relation("VendedorOrders", fields: [vendedor_id], references: [id], onDelete: Cascade)

  @@map("orders")
}